{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "runtime": "nodejs24"
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8081
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "apphosting": {
    "backendId": "doujin-info-prod",
    "rootDir": "web",
    "ignore": [
      "node_modules",
      ".git",
      ".emulator-data",
      ".firebase",
      ".next",
      "web/.next",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "firestore-debug.log",
      "firestore-debug.*.log",
      "ui-debug.log",
      "ui-debug.*.log",
      "functions",
      "logs",
      "docs",
      "workflows",
      "list-view-dry-run*.json",
      "phase*-result.json",
      "*.log",
      "*.zip",
      "*.tsbuildinfo"
    ]
  }
}
