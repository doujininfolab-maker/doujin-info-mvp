rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // products/{productId}: public catalog document. isActive: bool is required
    // for public reads. Writes are performed only by trusted Admin SDK jobs.
    // products/{productId}/dailyMetrics/{metricId}: public metric only while
    // the parent product is public. Client writes are never allowed.
    // taxonomies/{taxonomyId}: non-sensitive public display data, Admin-only writes.
    // rankingSnapshots, sellers and generated views: server-side source data that
    // can contain identifiers for hidden content; direct client access is denied.
    // contentVisibilityControls, contentVisibilityRuntime,
    // contentVisibilityEvents, contentVisibilityState: private operational data.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPublicProductData(data) {
      return data.keys().hasAll(['isActive']) && data.isActive is bool && data.isActive == true;
    }

    function publicProductExists(productId) {
      let productPath = /databases/$(database)/documents/products/$(productId);
      return exists(productPath) && isPublicProductData(get(productPath).data);
    }

    match /products/{productId} {
      allow get, list: if isPublicProductData(resource.data);
      allow create, update, delete: if false;

      match /dailyMetrics/{metricId} {
        allow get, list: if publicProductExists(productId);
        allow create, update, delete: if false;
      }

      match /{subdocument=**} {
        allow read, write: if false;
      }
    }

    match /taxonomies/{taxonomyId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /contentVisibilityControls/{document=**} {
      allow read, write: if false;
    }

    match /contentVisibilityRuntime/{document=**} {
      allow read, write: if false;
    }

    match /contentVisibilityEvents/{document=**} {
      allow read, write: if false;
    }

    match /contentVisibilityState/{document=**} {
      allow read, write: if false;
    }

    match /rankingSnapshots/{document=**} {
      allow read, write: if false;
    }

    match /sellers/{document=**} {
      allow read, write: if false;
    }

    match /batchRuns/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
