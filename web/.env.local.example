NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_ME

# Local emulator only
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8081
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
GOOGLE_CLOUD_PROJECT=doujin-info-mvp
GCLOUD_PROJECT=doujin-info-mvp

# Match the production rendering path while using local Firestore data.
LIST_VIEW_MODE=prefer
SEARCH_INDEX_READ_MODE=compact
SELLER_DETAIL_READ_MODE=stats
METRIC_HISTORY_READ_MODE=year
METRIC_HISTORY_DEBUG=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
